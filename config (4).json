{
  "name": "Hanover_EFOLibrary_BooleanButton",
  "label": "Boolean button",
  "description": "Boolean field rendered as a configurable action button (refresh/search). Each click updates the property and fires field change.",
  "organization": "Pega",
  "version": "1.0.4",
  "library": "EFOLibrary",
  "allowedApplications": [],
  "componentKey": "Hanover_EFOLibrary_BooleanButton",
  "type": "Field",
  "subtype": "Boolean",
  "properties": [
    {
      "label": "Field label (optional)",
      "format": "TEXT",
      "name": "label",
      "required": false
    },
    {
      "label": "Button label",
      "format": "TEXT",
      "name": "buttonLabel",
      "required": false
    },
    {
      "label": "Helper text",
      "format": "TEXT",
      "name": "helperText"
    },
    {
      "label": "Tooltip",
      "format": "TEXT",
      "name": "tooltip"
    },
    {
      "label": "Hide label",
      "format": "BOOLEAN",
      "name": "hideLabel"
    },
    {
      "name": "readOnly",
      "label": "Edit mode",
      "format": "READONLY"
    },
    {
      "label": "Button style",
      "format": "GROUP",
      "name": "design_group",
      "visibility": "(!readOnly = true)",
      "properties": [
        {
          "label": "Variant",
          "format": "SELECT",
          "name": "variant",
          "required": false,
          "source": [
            { "key": "primary", "value": "Primary" },
            { "key": "secondary", "value": "Secondary" },
            { "key": "simple", "value": "Simple" }
          ]
        },
        {
          "label": "Horizontal alignment",
          "format": "SELECT",
          "name": "alignment",
          "required": false,
          "source": [
            { "key": "left", "value": "Left" },
            { "key": "center", "value": "Center" },
            { "key": "right", "value": "Right" }
          ]
        },
        {
          "label": "Vertical alignment",
          "format": "SELECT",
          "name": "verticalAlign",
          "required": false,
          "source": [
            { "key": "top", "value": "Top" },
            { "key": "center", "value": "Center" },
            { "key": "bottom", "value": "Bottom" }
          ]
        },
        {
          "label": "Icon",
          "format": "SELECT",
          "name": "icon",
          "required": false,
          "source": [
            { "key": "none", "value": "None" },
            { "key": "refresh", "value": "Refresh" },
            { "key": "search", "value": "Search" },
            { "key": "check", "value": "Check" },
            { "key": "plus", "value": "Plus" }
          ]
        },
        {
          "label": "Full width",
          "format": "BOOLEAN",
          "name": "fullWidth"
        },
        {
          "label": "Background color (CSS, e.g. #0a6ed1)",
          "format": "TEXT",
          "name": "backgroundColor"
        },
        {
          "label": "Text color (CSS, e.g. #ffffff)",
          "format": "TEXT",
          "name": "textColor"
        },
        {
          "label": "Border radius (CSS, e.g. 8px)",
          "format": "TEXT",
          "name": "borderRadius"
        }
      ]
    },
    {
      "label": "Behavior",
      "format": "GROUP",
      "name": "behavior_group",
      "visibility": "(!readOnly = true)",
      "properties": [
        {
          "label": "On click",
          "format": "SELECT",
          "name": "valueBehavior",
          "required": false,
          "source": [
            { "key": "toggle", "value": "Toggle true/false" },
            { "key": "alwaysTrue", "value": "Always set true" }
          ]
        }
      ]
    },
    {
      "label": "Read-only settings",
      "format": "GROUP",
      "properties": [
        {
          "format": "SELECT",
          "name": "displayValue",
          "label": "Display Value",
          "defaultValue": "Yes/No",
          "localize": true,
          "splitValues": {
            "token": "/",
            "propertyNames": ["trueLabel", "falseLabel", "nullLabel"]
          },
          "source": [
            { "key": "Yes/No", "value": "Yes/No" },
            { "key": "True/False", "value": "True/False" },
            { "key": "Yes/No/Null", "value": "Yes/No/Null" },
            { "key": "True/False/Null", "value": "True/False/Null" }
          ]
        }
      ]
    },
    {
      "label": "Conditions",
      "format": "GROUP",
      "properties": [
        {
          "name": "required",
          "label": "Required",
          "format": "REQUIRED",
          "visibility": "(!readOnly = true)"
        },
        {
          "name": "disabled",
          "label": "Disabled",
          "format": "DISABLED",
          "visibility": "(!readOnly = true)"
        },
        {
          "name": "visibility",
          "label": "Visibility",
          "format": "VISIBILITY"
        }
      ]
    }
  ],
  "defaultConfig": {
    "label": "@L $this.label",
    "buttonLabel": "@L $this.label",
    "hideLabel": true,
    "variant": "primary",
    "alignment": "left",
    "icon": "none",
    "valueBehavior": "toggle",
    "verticalAlign": "bottom",
    "trueLabel": "@L Yes",
    "falseLabel": "@L No"
  }
}
